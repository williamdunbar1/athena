# ==============================================================================
# Athena — Variaveis de Ambiente (modelo seguro para versionamento)
# Copie este arquivo para `.env` e preencha apenas localmente. NUNCA commite `.env`.
# ==============================================================================

# --- LLM Principal (Google Gemini API) ---
# Obtenha em https://aistudio.google.com/apikey
GOOGLE_API_KEY=sua_chave_gemini_aqui
# Opcional: habilita o modelo Gemini 4 Neon no modo Auto ("true" ou "false")
PERMITIR_NEON=false
# Opcional: modelo usado para geracao de imagens
ATHENA_IMAGE_MODEL=google:gemini-3.1-flash-image

# --- Seguranca e Autenticacao da Interface Web/PWA ---
# PIN numerico opcional para proteger o acesso web/mobile (deixe vazio para desativar)
ATHENA_PIN=
# Segredo HMAC para assinar cookies de sessao (gere um valor aleatorio forte)
ATHENA_SECRET=troque_por_um_segredo_aleatorio_hex_de_32_bytes

# --- Observabilidade (Pydantic Logfire / OpenTelemetry) ---
# Token de escrita para envio de traces (opcional; se vazio, roda 100% local)
LOGFIRE_TOKEN=
# Token somente leitura para diagnostico via LogfireQueryClient (opcional)
LOGFIRE_READ_TOKEN=
# Opcional: sobrescreve a URL da Query API (detectada automaticamente do token US/EU)
LOGFIRE_QUERY_URL=
# Ambiente exibido nos traces (ex.: local, dev, prod)
ATHENA_ENV=local

# --- Segundo Cerebro (Obsidian) & Estudos (Faculdade / Ulife) ---
# Caminho para o Obsidian Vault (padrao: ~/Documents/Athena-Vault)
OBSIDIAN_VAULT=
# Caminho para a pasta de PDFs e perfil da faculdade (padrao: ~/Documents/agente-faculdade)
PASTA_FACULDADE=
# Login/RA usado apenas na renovacao de sessao do Portal Ulife (opcional)
ULIFE_LOGIN=

# --- RAG Hibrido (Qdrant + FastEmbed) ---
# Opcional: modelo CrossEncoder local de reranking
ATHENA_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
