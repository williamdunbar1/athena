# ==============================================================================
# Athena — Variaveis de Ambiente (modelo seguro para versionamento)
# Copie este arquivo para `.env` e preencha apenas localmente. NUNCA commite `.env`.
# ==============================================================================

# --- LLM Principal (Google Gemini API) ---
# Obtenha em https://aistudio.google.com/apikey
GOOGLE_API_KEY=sua_chave_gemini_aqui
# Opcional: habilita o modelo Gemini 4 Neon no modo Auto ("true" ou "false")
PERMITIR_NEON=false
# Opcional: modelo usado para geracao de imagens
ATHENA_IMAGE_MODEL=google:gemini-3.1-flash-image

# --- LLM Local Offline (Ollama — fallback final no Auto ou modo manual privado) ---
# URL do servidor Ollama local (padrao: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Modelo local preferido no Ollama (se nao instalado, usa o primeiro disponivel em /api/tags)
OLLAMA_MODEL=qwen2.5:7b
# Habilita tool-calling estruturado no Ollama local ("true" ou "false", padrao: false)
ATHENA_OLLAMA_TOOLS=false

# --- Banco de Dados, Cache Semantico e Voz Neural ---
# Caminho alternativo para o banco SQLite (padrao: memoria.db na raiz do projeto)
ATHENA_DB_PATH=
# TTL em segundos do Cache Semantico local (padrao: 900 = 15 min)
ATHENA_SEMANTIC_CACHE_TTL=900
# Voz neural Edge-TTS e modelo Whisper local (opcionais)
ATHENA_TTS_VOICE=pt-BR-FranciscaNeural
ATHENA_WHISPER_MODEL=small

# --- Seguranca e Autenticacao da Interface Web/PWA ---
# PIN numerico opcional para proteger o acesso web/mobile (deixe vazio para desativar)
ATHENA_PIN=
# Segredo HMAC para assinar cookies de sessao (gere um valor aleatorio forte)
ATHENA_SECRET=troque_por_um_segredo_aleatorio_hex_de_32_bytes

# --- Observabilidade (Pydantic Logfire / OpenTelemetry) ---
# Token de escrita para envio de traces (opcional; se vazio, roda 100% local)
LOGFIRE_TOKEN=
# Token somente leitura para diagnostico via LogfireQueryClient (opcional)
LOGFIRE_READ_TOKEN=
# Opcional: sobrescreve a URL da Query API (detectada automaticamente do token US/EU)
LOGFIRE_QUERY_URL=
# Ambiente exibido nos traces (ex.: local, dev, prod)
ATHENA_ENV=local
# Formato dos logs estruturados com structlog ("console" para dev local, "json" para auditoria/producao)
ATHENA_LOG_FORMAT=console
# Nivel minimo de log estruturado (DEBUG, INFO, WARNING, ERROR)
ATHENA_LOG_LEVEL=INFO
# Extracao automatica de fatos duradouros em 2o plano apos cada resposta ("true" ou "false")
ATHENA_AUTO_MEMORY=true

# --- Segundo Cerebro (Obsidian) & Estudos (Faculdade / Ulife) ---
# Caminho para o Obsidian Vault (padrao: ~/Documents/Athena-Vault)
OBSIDIAN_VAULT=
# Caminho para a pasta de PDFs e perfil da faculdade (padrao: ~/Documents/agente-faculdade)
PASTA_FACULDADE=
# Login/RA usado apenas na renovacao de sessao do Portal Ulife (opcional)
ULIFE_LOGIN=

# --- RAG Hibrido (Qdrant + FastEmbed) & Extracao de Documentos ---
# Opcional: modelo CrossEncoder local de reranking
ATHENA_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Opcional: ativa Docling para extracao estrutural avancada de PDFs (requer extra `docs`)
ATHENA_USE_DOCLING=false

# --- Athena Lab (R&D Auto-Evolucao Controlada + Google Antigravity) ---
# Job semanal automatico (desligado por padrao para nao consumir cota sem autorizacao)
ATHENA_LAB_AUTO_SCHEDULE=false
# Usa Antigravity CLI em modo headless (ou fallback "Modo Briefing VS Code" se CLI ausente)
ATHENA_LAB_USE_CLI=true
# Opcional: nome ou caminho absoluto do binario CLI (padrao: auto-detecta `agy` ou `antigravity`)
ATHENA_CODING_CLI=

# --- Logfire Sentinel (Vigia Auto-Healing conectado ao Athena Lab) ---
ATHENA_SENTINEL_ENABLED=true
ATHENA_SENTINEL_INTERVAL_MIN=10
ATHENA_SENTINEL_MAX_POR_HORA=2
