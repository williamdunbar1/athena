{
  "servidores": [
    {
      "nome": "athena-utilidades",
      "ativo": true,
      "transporte": "stdio",
      "comando": "${PYTHON}",
      "args": [
        "mcp_utilidades.py"
      ],
      "url": "",
      "descricao": "Servidor MCP local de utilidades (calculadora AST segura e diagnostico do PC)"
    },
    {
      "nome": "exemplo-http-externo",
      "ativo": false,
      "transporte": "http",
      "comando": "",
      "args": [],
      "url": "https://exemplo.invalid/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_EXEMPLO_TOKEN}"
      },
      "descricao": "Modelo de servidor MCP remoto via Streamable HTTP (configure MCP_EXEMPLO_TOKEN no .env e mude ativo para true)"
    }
  ]
}
